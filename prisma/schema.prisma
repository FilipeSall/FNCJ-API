generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id                 String            @id @default(uuid())
  nome               String
  telefone           String
  emailPessoal       String            @unique
  emailInstitucional String            @unique
  cpf                String            @unique
  rg                 String
  orgaoEmissorRG     String
  dataExpedicaoRG    DateTime
  dataNascimento     DateTime
  cep                String
  uf                 String
  cidade             String
  bairro             String
  logradouro         String
  numero             String
  complemento        String?
  senha              String
  tipoUsuario        String            @default("NAO_FILIADO")
  instituicaoId      Int
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  // InscricaoEvento    InscricaoEvento[]
  instituicao        Instituicao       @relation(fields: [instituicaoId], references: [id])
}

model Instituicao {
  id    Int    @id @default(autoincrement())
  nome  String @unique
  users User[]
}

model Evento {
  id                     String                 @id @default(uuid())
  nome                   String
  sigla                  String?
  dataInicio             DateTime?
  dataFim                DateTime?
  cidade                 String?
  uf                     String?
  premioId               String?
  completo               Boolean                @default(false)
  vencimentoLote1        DateTime?
  vencimentoLote2        DateTime?
  vencimentoLote3        DateTime?
  precoLote1Filiado      Float?
  precoLote1NaoFiliado   Float?
  precoLote1Estudante    Float?
  precoLote2Filiado      Float?
  precoLote2NaoFiliado   Float?
  precoLote2Estudante    Float?
  precoLote3Filiado      Float?
  precoLote3NaoFiliado   Float?
  precoLote3Estudante    Float?
  precoEmpenhoFiliado    Float?
  precoEmpenhoNaoFiliado Float?
  precoEmpenhoEstudante  Float?
  limiteFiliacao         DateTime?
  linkPesquisaOpiniao    String?
  linkResultadosPesquisa String?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  certificados           Certificado[]
  premio                 Premio?                @relation(fields: [premioId], references: [id])
  formasPagamentoEvento  EventoFormaPagamento[]
  inscricoes             InscricaoEvento[]
}

model EventoFormaPagamento {
  id             String @id @default(uuid())
  eventoId       String
  formaPagamento String
  evento         Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([eventoId, formaPagamento])
}

model Premio {
  id        String   @id @default(uuid())
  nome      String
  edicao    String
  completo  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  eventos   Evento[]
}

model Certificado {
  id          String  @id @default(uuid())
  nome        String
  tipo        String
  eventoId    String
  templateUrl String?
  evento      Evento  @relation(fields: [eventoId], references: [id])
}

model InscricaoEvento {
  id              String   @id @default(uuid())
  userId          String
  eventoId        String
  dataInscricao   DateTime @default(now())
  statusPagamento String   @default("PENDENTE")
  formaPagamento  String?
  valorPago       Float?
  lote            Int?
  evento          Evento   @relation(fields: [eventoId], references: [id])
  // User            User     @relation(fields: [userId], references: [id])

  @@unique([userId, eventoId])
}
